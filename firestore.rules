rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidUserData() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'createdAt']) &&
             data.uid == request.auth.uid;
    }

    function isValidWarden() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'wardenId', 'level', 'exp', 'unlockedAt']) &&
             data.level > 0 && data.level <= 10 &&
             data.exp >= 0 &&
             data.uid == request.auth.uid;
    }

    function isValidMatchLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'aiDifficulty', 'result', 'skillTriggeredCount', 'playerScore', 'aiScore', 'movesPlayed', 'playedAt']) &&
             data.skillTriggeredCount >= 0 &&
             data.playerScore >= 0 &&
             data.aiScore >= 0 &&
             data.movesPlayed >= 0 &&
             data.uid == request.auth.uid;
    }

    // User documents (public metadata only)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUserData();
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // User's wardens (private)
      match /wardens/{wardenId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWarden();
        allow update: if isOwner(userId) && isValidWarden();
        allow delete: if isOwner(userId);
      }

      // User's match logs (private)
      match /matchLogs/{matchLogId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMatchLog();
        allow update: if isOwner(userId) && isValidMatchLog();
        allow delete: if isOwner(userId);
      }

      // User's friend list (private, one-directional: only the owner
      // can read or write their own list of friend uids).
      match /friends/{friendUid} {
        function isValidFriend() {
          let data = request.resource.data;
          return data.keys().hasAll(['uid', 'addedAt']) &&
                 data.uid == friendUid;
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFriend();
        allow update: if isOwner(userId) && isValidFriend();
        allow delete: if isOwner(userId);
      }
    }

    // Share cards (public leaderboard)
    match /shareCards/{cardId} {
      allow read: if true; // Public viewing
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
                      request.resource.data.keys().hasAll(['uid', 'matchLogId', 'imageUrl', 'createdAt']);
      allow update: if isOwner(request.resource.data.uid) &&
                       request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(resource.data.uid);

      // Prevent unauth access to uid field in queries
      allow list: if true;
    }

    // Global leaderboard (public, one doc per user, client-aggregated
    // stats — same trust model as match logs elsewhere in this app).
    match /leaderboardEntries/{userId} {
      function isValidLeaderboardEntry() {
        let data = request.resource.data;
        return data.keys().hasAll(['uid', 'totalWins', 'totalMatches', 'bestWinStreak', 'updatedAt']) &&
               data.uid == request.auth.uid &&
               data.totalWins >= 0 &&
               data.totalMatches >= data.totalWins &&
               data.bestWinStreak >= 0 &&
               data.bestWinStreak <= data.totalMatches;
      }

      allow read: if true;
      allow create: if isOwner(userId) && isValidLeaderboardEntry();
      allow update: if isOwner(userId) && isValidLeaderboardEntry();
      allow delete: if isOwner(userId);
    }

    // Asynchronous friend matches (multiplayer)
    match /multiplayerMatches/{matchId} {
      function isParticipant() {
        return isAuthenticated() &&
               (resource.data.hostUid == request.auth.uid ||
                resource.data.guestUid == request.auth.uid);
      }

      // Waiting matches are readable by anyone signed in so a guest can
      // look one up by invite code before joining; once a guest is
      // assigned, only the two participants may read/write it.
      allow read: if isAuthenticated() &&
                     (resource.data.guestUid == null || isParticipant());
      allow create: if isAuthenticated() &&
                       request.resource.data.hostUid == request.auth.uid &&
                       request.resource.data.guestUid == null;
      // Joining: guest may claim an open match. Playing: either
      // participant may update moves/status on an already-claimed match.
      allow update: if isAuthenticated() &&
                       (
                         (resource.data.guestUid == null &&
                          request.resource.data.guestUid == request.auth.uid)
                         || isParticipant()
                       );
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
